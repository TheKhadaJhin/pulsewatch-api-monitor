# Runtime
PULSEWATCH_ENVIRONMENT=development
PULSEWATCH_LOG_LEVEL=INFO
PULSEWATCH_LOG_JSON=false

# SQLite for local development. Docker Compose overrides this with PostgreSQL.
PULSEWATCH_DATABASE_URL=sqlite+aiosqlite:///data/pulsewatch.db
PULSEWATCH_AUTO_CREATE_SCHEMA=true

# Docker Compose local default; replace for any shared environment.
PULSEWATCH_POSTGRES_PASSWORD=pulsewatch-local

# Check engine
PULSEWATCH_CHECK_CONCURRENCY=5
PULSEWATCH_RETRY_BACKOFF_SECONDS=0.2
PULSEWATCH_DEGRADED_LATENCY_MS=750
PULSEWATCH_ALLOW_PRIVATE_HOSTS=false

# Scheduler and retention
PULSEWATCH_SCHEDULER_ENABLED=true
PULSEWATCH_SCHEDULER_POLL_SECONDS=5
PULSEWATCH_SCHEDULER_BATCH_SIZE=100
PULSEWATCH_RETENTION_DAYS=30
PULSEWATCH_RETENTION_INTERVAL_SECONDS=3600

# Generate with: pulsewatch generate-key
PULSEWATCH_ADMIN_API_KEY=

# Optional signed webhook for incident_opened and incident_resolved events
PULSEWATCH_WEBHOOK_URL=
PULSEWATCH_WEBHOOK_SECRET=
PULSEWATCH_WEBHOOK_TIMEOUT_SECONDS=5
PULSEWATCH_WEBHOOK_RETRY_COUNT=2

# Operations
PULSEWATCH_METRICS_ENABLED=true
PULSEWATCH_CORS_ORIGINS=

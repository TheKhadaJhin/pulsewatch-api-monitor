# SQLite file used by the application
PULSEWATCH_DATABASE_PATH=data/pulsewatch.db

# Maximum simultaneous HTTP checks (1-20)
PULSEWATCH_CHECK_CONCURRENCY=5

# Base delay for exponential retry backoff
PULSEWATCH_RETRY_BACKOFF_SECONDS=0.2

# A successful response above this latency is classified as degraded
PULSEWATCH_DEGRADED_LATENCY_MS=750

# Keep false for public deployments. Enable only to monitor trusted LAN services.
PULSEWATCH_ALLOW_PRIVATE_HOSTS=false
